<!--
  Scenariusz "lot do beacona" nad losowym terenem.
  Teren: heightfield 60 x 60 m otoczony ścianami 8 m. Wysokości (pagórki do +2 m, zagłębienia do -1 m)
  i pozycję celu losuje sim/terrain.py: randomize(model, data, seed) — bez tego teren jest płaski
  na z = -1 m, a cel wisi w powietrzu, więc scenę zawsze ładujemy przez randomize (robi to sim.viewer).
  Cel = pole lądowania 1.2 x 1.2 m (12 x 12 kratek) z masztem i flagą pośrodku.
  Maszt jest ciemny i wysoki, żeby był widoczny z daleka w kamerach-oczach (kontrast z niebem).
  Site "target" (środek pola na podłodze) i geom "target_zone" czyta sim/target.py.
  Pole i flaga nie kolidują; maszt i teren tak.
-->
<mujoco model="neurofly beacon">
  <include file="common.xml"/>
  <!-- Podgląd MuJoCo ustawia startową kamerę na 1.5 * extent od center; bez tego extent liczy się
       z 60-metrowego terenu i kamera startuje kilkadziesiąt m od drona. zfar jest względny do extent,
       więc podnosimy go, żeby widać było całą mapę (150 m > przekątna 85 m). -->
  <statistic extent="1" center="0 0 0.3"/>
  <visual>
    <map zfar="150"/>
  </visual>

  <asset>
    <!-- 301 x 301 punktów = 0.2 m; size: pół-boki 30 m, zakres wysokości 3 m (od -1 do +2), podstawa 0.5 m -->
    <hfield name="terrain" nrow="301" ncol="301" size="30 30 3 0.5"/>
    <!-- kratka tej samej wielkości co na płaskiej podłodze (150 powtórzeń tekstury na 60 m) -->
    <!-- reflectance 0: odbicie (było 0.05, praktycznie niewidoczne) wymuszało drugi przebieg renderu z cieniami —
         ~8 ms na każde oko i klatkę podglądu; bez niego oko renderuje się w ~1.3 ms -->
    <!-- styl "blueprint" (poligon testowy): tekstury z sim/tools/build_blueprint_textures.py.
         Podłoże: kafel 4 x 4 m (siatka 0.5 m), 15 powtórzeń na 60 m. -->
    <texture name="blueprint_ground" type="2d" file="../textures/blueprint_ground.png"/>
    <texture name="blueprint_block" type="cube" file="../textures/blueprint_block.png"/>
    <material name="terrain" texture="blueprint_ground" texrepeat="15 15" reflectance="0"/>
    <!-- bloki (sim/blocks.py): odcień z geom_rgba -->
    <material name="block" texture="blueprint_block" specular="0.2" shininess="0.3"/>
    <material name="wall" rgba="0.45 0.7 1.0 0.25"/>
    <material name="target_zone" rgba="0.95 0.45 0.05 1"/>
    <material name="target_border" rgba="0.95 0.95 0.95 1"/>
    <material name="beacon_pole" rgba="0.05 0.05 0.05 1"/>
    <material name="beacon_flag" rgba="0.85 0.05 0.05 1"/>
  </asset>

  <worldbody>
    <geom name="terrain" type="hfield" hfield="terrain" material="terrain" pos="0 0 -1"/>
    <!-- granice mapy: półprzezroczyste ściany 8 m wokół terenu -->
    <geom name="wall_north" type="box" size="30.2 0.2 4.5" pos="0 30.2 3.5" material="wall"/>
    <geom name="wall_south" type="box" size="30.2 0.2 4.5" pos="0 -30.2 3.5" material="wall"/>
    <geom name="wall_east" type="box" size="0.2 30.2 4.5" pos="30.2 0 3.5" material="wall"/>
    <geom name="wall_west" type="box" size="0.2 30.2 4.5" pos="-30.2 0 3.5" material="wall"/>
    <body name="target" pos="5 -1.5 0">
      <site name="target" pos="0 0 0" size="0.05" group="5"/>
      <geom name="target_border" type="box" size="0.65 0.65 0.002" pos="0 0 0.002"
            material="target_border" contype="0" conaffinity="0"/>
      <geom name="target_zone" type="box" size="0.6 0.6 0.003" pos="0 0 0.003"
            material="target_zone" contype="0" conaffinity="0"/>
      <geom name="beacon_pole" type="cylinder" size="0.04 1.25" pos="0 0 1.25" material="beacon_pole"/>
      <geom name="beacon_flag" type="box" size="0.3 0.005 0.2" pos="0.33 0 2.25"
            material="beacon_flag" contype="0" conaffinity="0"/>
      <geom name="beacon_top" type="sphere" size="0.07" pos="0 0 2.53" material="beacon_flag"
            contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
